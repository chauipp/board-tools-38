# 1. Tạo tài khoản free tại https://www.mongodb.com/atlas
# 2. Tạo cluster M0 (free forever), tạo user + mật khẩu database
# 3. Trong Atlas bấm "Connect" -> "Drivers" -> copy connection string, dán vào đây
# 4. Copy file này thành .env (không commit .env thật lên git) rồi điền giá trị thật
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/game-tools?retryWrites=true&w=majority

PORT=3001

# 5. Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID
#    (Web application). Authorized origins: http://localhost:5173 and your Render URL.
#    Same value must also be set as client/.env.local's VITE_GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

# 6. Bất kỳ chuỗi ngẫu nhiên dài nào — dùng để ký session JWT.
SESSION_SECRET=

# 7. Danh sách email được phép đăng nhập, cách nhau bởi dấu phẩy.
ALLOWED_EMAILS=you@gmail.com,colleague@gmail.com

# 8. Bắt buộc phải là "true" khi deploy production (HTTPS) để session cookie
#    có cờ Secure. Để trống/false khi chạy local qua HTTP, nếu không trình
#    duyệt sẽ không lưu cookie và đăng nhập sẽ không hoạt động.
COOKIE_SECURE=

# 9. Cloudflare R2 cho PDF bền vững khi Render redeploy. Tạo bucket private,
# API token có Object Read & Write cho bucket đó, rồi điền đủ BỐN biến dưới.
# Để trống toàn bộ khi chạy local: PDF sẽ lưu tại server/uploads/pdf/.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=game-tools-pdf

# 10. Discord webhook để nhận cảnh báo dung lượng kho PDF: mở Server Settings ->
# Integrations -> Webhooks -> New Webhook, chọn kênh, bấm "Copy Webhook URL".
# Để trống thì cảnh báo chỉ ghi vào log server. URL của Slack cũng dùng được.
DISCORD_WEBHOOK_URL=

# 11. Ngưỡng dung lượng kho PDF, đơn vị GB thập phân (10^9) đúng như cách
# Cloudflare đếm. Gói free của R2 là 10 GB; trần cứng để mặc định 8 GB để còn
# đệm cho phần usage Cloudflare đếm trễ và file mồ côi chưa tới lượt dọn.
# Chạm trần là CHẶN upload mới, không phải chỉ cảnh báo.
# Để trống toàn bộ là dùng mặc định: chặn 8, gần đầy 7.5, cảnh báo 6.
PDF_QUOTA_LIMIT_GB=
PDF_QUOTA_HIGH_GB=
PDF_QUOTA_WARN_GB=

# 12. Xoá thẻ PDF thì file chỉ bị đánh dấu mồ côi, phải qua bấy nhiêu giờ mới bị
# xoá thật khỏi R2 — để Ctrl+Z sau khi xoá thẻ còn cứu được file. Mặc định 24.
PDF_ORPHAN_GRACE_HOURS=
